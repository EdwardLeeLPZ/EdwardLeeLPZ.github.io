---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    <div class="cv">
      {% for entry in site.data.cv %}
        <a class="anchor" id="{{ entry.title }}"></a>
        <div class="cv-section">
          <div class="cv-section__heading">
            <span class="cv-section__index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <h3 class="cv-section-title">{{ entry.title }}</h3>
          </div>
          <div class="cv-section__body">
            {% if entry.type == 'list' %}
              {% include cv/list.liquid %}
            {% elsif entry.type == 'map' %}
              {% include cv/map.liquid %}
            {% elsif entry.type == 'nested_list' %}
              {% include cv/nested_list.liquid %}
            {% elsif entry.type == 'time_table' %}
              {% include cv/time_table.liquid %}
            {% elsif entry.type == 'list_groups' %}
              {% include cv/list_groups.liquid %}
            {% else %}
              {{ entry.contents }}
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
    {% if page.cv_pdf %}
      <div class="cv-section">
        <div class="cv-section__heading">
          <span class="cv-section__index">CV</span>
          <h3 class="cv-section-title">Resume</h3>
        </div>
        <div class="cv-section__body">
          <div class="pdf-viewer-container" oncontextmenu="return false;">
            <div id="pdf-pages"></div>
            <div class="pdf-controls">
              <button id="pdf-prev" class="btn btn-sm z-depth-0"><i class="fa-solid fa-chevron-left"></i> Prev</button>
              <span id="pdf-page-info"></span>
              <button id="pdf-next" class="btn btn-sm z-depth-0">Next <i class="fa-solid fa-chevron-right"></i></button>
            </div>
          </div>
        </div>
      </div>
      <!-- .cv-section -->
      <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
      <script>
        (function () {
          var url = '{{ page.cv_pdf | prepend: "assets/pdf/" | relative_url }}';
          var pdfDoc = null;
          var pageNum = 1;
          var rendering = false;
          var resizeTimer = null;
          var container = document.getElementById('pdf-pages');
          var pageInfo = document.getElementById('pdf-page-info');

          pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

          function renderPage(num) {
            if (!pdfDoc || !container.clientWidth) return;
            rendering = true;
            pdfDoc.getPage(num).then(function (page) {
              var containerWidth = container.clientWidth;
              var unscaledViewport = page.getViewport({ scale: 1 });
              var scale = containerWidth / unscaledViewport.width;
              var viewport = page.getViewport({ scale: scale });
              var outputScale = Math.min(window.devicePixelRatio || 1, 2.5);

              container.innerHTML = '';
              var canvas = document.createElement('canvas');
              canvas.style.width = Math.floor(viewport.width) + 'px';
              canvas.style.height = Math.floor(viewport.height) + 'px';
              canvas.style.maxWidth = '100%';
              canvas.style.display = 'block';
              var ctx = canvas.getContext('2d');
              canvas.height = Math.floor(viewport.height * outputScale);
              canvas.width = Math.floor(viewport.width * outputScale);
              container.appendChild(canvas);

              var transform = outputScale !== 1 ? [outputScale, 0, 0, outputScale, 0, 0] : null;
              page.render({ canvasContext: ctx, transform: transform, viewport: viewport }).promise.then(function () {
                rendering = false;
              });
            });
            pageInfo.textContent = num + ' / ' + pdfDoc.numPages;
          }

          document.getElementById('pdf-prev').addEventListener('click', function () {
            if (pageNum <= 1 || rendering) return;
            pageNum--;
            renderPage(pageNum);
          });
          document.getElementById('pdf-next').addEventListener('click', function () {
            if (!pdfDoc || pageNum >= pdfDoc.numPages || rendering) return;
            pageNum++;
            renderPage(pageNum);
          });

          pdfjsLib.getDocument(url).promise.then(function (pdf) {
            pdfDoc = pdf;
            renderPage(1);
          });

          window.addEventListener('resize', function () {
            window.clearTimeout(resizeTimer);
            resizeTimer = window.setTimeout(function () {
              if (!rendering) renderPage(pageNum);
            }, 150);
          });
        })();
      </script>
    {% endif %}
  </article>
</div>
